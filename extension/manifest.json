{
  "manifest_version": 3,
  "name": "URL Album",
  "version": "2.2.5",
  "description": "Save current tab to URL Album",
  "key": "",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1:27124/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to URL Album",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
