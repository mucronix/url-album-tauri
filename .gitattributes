# Переводы строк: в репозитории всегда LF, в рабочем дереве — по платформе.
# Без этого файла поведение зависит от core.autocrlf на конкретной машине,
# и один и тот же файл у разных людей даёт диff во весь файл.
* text=auto eol=lf

# ── Исходники и документация ────────────────────────────────────────────────
*.rs    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.svg   text eol=lf

# README.txt открывают Блокнотом на чужой Windows-машине — там нужен CRLF,
# иначе текст слипается в одну строку в старых редакторах.
README.txt text eol=crlf

# ── Данные старого URL-Album: НЕ ТРОГАТЬ ────────────────────────────────────
# ua.dat — эталон формата для importer.rs: Windows-1251, TSV с ведущими
# табуляциями, «^^» вместо переноса строки. NUL-байтов в нём нет, поэтому
# text=auto счёл бы его текстом и переписал переводы строк — а вместе с ними
# сломал бы образец, по которому проверяется парсер. Сейчас эти файлы
# в .gitignore, правило стоит на случай, если их когда-нибудь добавят.
*.dat   -text
*.bak   -text

# ── Двоичное: явно, не полагаясь на автоопределение ─────────────────────────
*.png   binary
*.ico   binary
*.exe   binary
*.dll   binary
*.zip   binary
*.db    binary
*.pem   binary
